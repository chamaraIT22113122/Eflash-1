# Eflash Website Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ====================================
# MongoDB (Required for API routes)
# ====================================
# Get a free cluster at https://cloud.mongodb.com/
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

MONGODB_URI=mongodb+srv://youruser:yourpassword@yourcluster.mongodb.net/eflash

# ====================================
# EmailJS Configuration
# ====================================
# Get these from https://www.emailjs.com/
# See EMAILJS_SETUP_GUIDE.md for detailed instructions

VITE_EMAILJS_SERVICE_ID=service_your_service_id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_your_contact_template_id
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=template_your_newsletter_template_id
VITE_EMAILJS_PUBLIC_KEY=user_your_public_key

# ====================================
# Google Analytics 4
# ====================================
# Get this from https://analytics.google.com/
# Create a GA4 property and copy the Measurement ID

VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ====================================
# API URL
# ====================================
# On Vercel: leave as /api (same host, no domain needed)
# For a separate backend: use full URL e.g. https://api.yourdomain.com/api

VITE_API_URL=/api
